<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- 1. Default Document: IIS already does this, but we explicitly enable it -->
    <defaultDocument enabled="true">
      <files>
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- 2. Handle SPA Fallback for routes that don't have a physical index.html -->
    <rewrite>
      <rules>
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- If the request is NOT for a file that exists on disk (JS, CSS, images) -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- If the request is NOT for a folder that exists on disk (like your pre-rendered /about folder) -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <!-- Rewrite everything else to the root index.html -->
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- 3. Caching for static assets (optional but recommended) -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!-- 4. Ensure proper MIME types for modern JS/CSS -->
    <mimeMap fileExtension=".js" mimeType="application/javascript" />
    <mimeMap fileExtension=".css" mimeType="text/css" />
    <mimeMap fileExtension=".json" mimeType="application/json" />
  </system.webServer>
</configuration>