/**
 * Store dell'Area Riservata Tour Operator.
 * ----------------------------------------------------------------
 * Stato centralizzato per l'applicazione. Gestisce autenticazione,
 * dati del catalogo, opzioni, prenotazioni, vendite, audit log.
 *
 * Ruoli:
 *   - "admin": visualizza e opera su tutti i Tour Operator;
 *   - "to":    visualizza e opera solo sui propri dati.
 */
import * as React from "react";
import { toast } from "sonner";
import { api, UtenteDto, ApiError, type RigaRequest } from "@/lib/api";
import { loadGare, prefetchDettaglioGara, nomeGara, type SettoreCatalogo } from "@/lib/catalog";

export const OPTION_EXPIRY_ISO = "2026-10-19T23:59:59.000Z";

// ----- Persistenza carrello in sessionStorage (per utente) -----
const cartKey = (userId: number | string | undefined) => `areato.cart.${userId ?? "anon"}`;

function readCartFromSession(userId: number | string | undefined): CartItem[] {
  if (typeof window === "undefined" || !userId) return [];
  try {
    const raw = window.sessionStorage.getItem(cartKey(userId));
    return raw ? (JSON.parse(raw) as CartItem[]) : [];
  } catch {
    return [];
  }
}

function writeCartToSession(userId: number | string | undefined, cart: CartItem[]) {
  if (typeof window === "undefined" || !userId) return;
  try {
    window.sessionStorage.setItem(cartKey(userId), JSON.stringify(cart));
  } catch {
    /* quota / privacy mode: ignora */
  }
}

function removeCartFromSession(userId: number | string | undefined) {
  if (typeof window === "undefined" || !userId) return;
  window.sessionStorage.removeItem(cartKey(userId));
}
// ----- Tipi -----
export type Role = "admin" | "to";
export type RaceCode =
  | "SPRINT_M"
  | "SPRINT_W"
  | "PURSUIT_M"
  | "PURSUIT_W"
  | "INDIVIDUAL_M"
  | "INDIVIDUAL_W"
  | "MASSSTART_M"
  | "MASSSTART_W"
  | "RELAY_M"
  | "RELAY_W"
  | "MIXED_RELAY";

export type Race = {
  id: string;
  code: RaceCode;
  name: string;
  date: string | null;
  discipline: string;
};

export type Sector = {
  id: string;
  raceId: string;
  name: string;
  capacity: number;
  sold: number;
  priceTo: number;
  numbered: boolean;
  priceCategory: "INTERO" | "RIDOTTO" | "ABBONAMENTO";
};

export type OptionStatus = "pending" | "active" | "expired" | "released" | "converted" | "rejected";
export type BookingStatus = "pending_payment" | "partially_paid" | "paid" | "cancelled" | "issued";

export type TicketOption = {
  id: string;
  toId: string;
  raceId: string;
  sectorId: string;
  qty: number;
  createdAt: string;
  expiresAt: string;
  status: OptionStatus;
  note?: string;
  pdfSent?: boolean;
};

export type Booking = {
  id: string;
  fromOptionId?: string;
  toId: string;
  raceId: string;
  sectorId: string;
  qty: number;
  total: number;
  deposit: number;
  paid: number;
  paymentDueAt: string;
  customer: string;
  status: BookingStatus;
  createdAt: string;
};

export type Sale = {
  id: string;
  bookingId: string;
  toId: string;
  voucherCode: string;
  qty: number;
  total: number;
  issuedAt: string;
  customer: string;
  raceId: string;
  sectorId: string;
};

export type AuditEntry = {
  id: string;
  at: string;
  user: string;
  ip: string;
  entity: "option" | "booking" | "sale" | "auth" | "operator";
  entityId: string;
  action: string;
  details?: string;
};

export type TourOperator = {
  id: string;
  name: string;
  type: "TO" | "FanClub";
  email: string;
  plafond: number;
  used: number;
  enabled: boolean;
  partnerDiscount: number;
  company?: string;
};

